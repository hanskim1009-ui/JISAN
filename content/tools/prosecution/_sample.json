    "questions": [
      { "id": "bac", "label": "혈중알코올농도", "type": "number", "unit": "%", "min": 0.03, "max": 0.5, "step": 0.001 },
      { "id": "priors", "label": "음주운전 전과", "type": "number", "unit": "회", "min": 0, "max": 10, "step": 1 },
      {
        "id": "accident",
        "label": "사고 여부",
        "type": "select",
        "options": [
          { "value": "none", "label": "사고 없음" },
          { "value": "property", "label": "물적 피해" },
          { "value": "injury", "label": "사람이 다침" }
        ]
      }
    ],
    "tiers": [
      { "level": "detention", "when": [[{ "q": "priors", "op": "gte", "value": 3 }], [{ "q": "bac", "op": "gte", "value": 0.2 }, { "q": "accident", "op": "eq", "value": "injury" }]], "sentence": "징역 2년 이상" },
      { "level": "trial", "when": [[{ "q": "priors", "op": "gte", "value": 1 }], [{ "q": "accident", "op": "eq", "value": "injury" }]], "sentence": "징역 1년 ~ 2년" },
      { "level": "trial-fine", "when": [[{ "q": "bac", "op": "gte", "value": 0.2 }]], "fine": { "base": 15000000, "atLeast": true } },
      { "level": "summary", "when": [[{ "q": "accident", "op": "in", "value": ["none", "property"] }]], "fine": { "base": 4000000, "perUnit": { "q": "bac", "over": 0.03, "amount": 100000000 }, "max": 20000000 } }
    ]
  },
  {
