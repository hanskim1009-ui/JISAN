      {
        "id": "settled",
        "label": "피해자와 합의",
        "type": "select",
        "options": [
          { "value": "yes", "label": "합의함" },
          { "value": "no", "label": "합의 못 함" }
        ]
      },
      { "id": "priors", "label": "같은 종류 전과", "type": "number", "unit": "회", "min": 0, "max": 20, "step": 1 }
    ],
    "tiers": [
      { "level": "detention", "when": [[{ "q": "weeks", "op": "gte", "value": 12 }, { "q": "settled", "op": "eq", "value": "no" }], [{ "q": "priors", "op": "gte", "value": 3 }]], "sentence": "징역 2년 이상", "note": "진단이 길거나 전과가 많으면 구속 수사가 검토될 수 있습니다." },
      { "level": "trial", "when": [[{ "q": "weeks", "op": "gte", "value": 8 }]], "sentence": "징역 8월 ~ 1년 6월" },
      { "level": "trial-fine", "when": [[{ "q": "weeks", "op": "gt", "value": 4 }, { "q": "settled", "op": "neq", "value": "yes" }]], "fine": { "base": 5000000, "perUnit": { "q": "weeks", "over": 4, "amount": 1000000 }, "max": 10000000 } },
      { "level": "suspension", "when": [[{ "q": "settled", "op": "eq", "value": "yes" }, { "q": "priors", "op": "lt", "value": 1 }]], "note": "초범이고 합의하면 재판에 넘기지 않을 수 있습니다." },
      { "level": "summary", "when": [], "fine": { "base": 1500000, "perUnit": { "q": "weeks", "over": 2, "amount": 500000 }, "max": 10000000 } }
    ],
    "notes": ["합의 여부가 처분에 크게 영향을 줍니다."]
  },
  {
    "id": "sample-drunk",
    "name": "음주운전 (시험용)",
